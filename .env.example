# App
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database
DATABASE_URL=postgresql://kalshi:kalshi@localhost:5432/kalshi_tracker?schema=public

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Kalshi API
# Use demo first. Production base URL can be swapped once tested.
KALSHI_ENV=demo
KALSHI_API_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private.key
# Netlify-friendly alternative to KALSHI_PRIVATE_KEY_PATH.
KALSHI_PRIVATE_KEY_PEM=
KALSHI_PRIVATE_KEY_BASE64=

# Credential encryption for future DB-stored credentials
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Safety
ENABLE_TRADING_ENDPOINTS=false
READ_ONLY_MODE=true
