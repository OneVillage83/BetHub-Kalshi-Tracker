{
  "name": "kalshi-bet-tracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @kalshi-tracker/web dev",
    "dev:web": "pnpm --filter @kalshi-tracker/web dev",
    "dev:api": "pnpm --filter @kalshi-tracker/api dev",
    "build": "pnpm --filter @kalshi-tracker/web build",
    "sync:backfill": "pnpm --filter @kalshi-tracker/sync-worker backfill",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "dependencies": {
    "@kalshi-tracker/db": "workspace:*",
    "@kalshi-tracker/kalshi-client": "workspace:*",
    "@netlify/functions": "5.2.2"
  },
  "devDependencies": {
    "@prisma/client": "7.8.0",
    "prisma": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
