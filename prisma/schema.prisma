generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KalshiEnvironment {
  production
}

enum SyncRunStatus {
  running
  success
  failed
  stub
}

enum OutcomeSide {
  yes
  no
  unknown
}

enum OrderStatus {
  resting
  executed
  canceled
  unknown
}

enum AppUserRole {
  owner
  user
}

model AppUser {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  role        AppUserRole @default(user)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    KalshiAccount[]
  notes       BetNote[]
  syncRuns    SyncRun[]
  invitesSent Invite[] @relation("InvitesSent")
  acceptedInvite Invite? @relation("InviteAcceptedBy")
}

model KalshiAccount {
  id          String            @id @default(cuid())
  appUserId   String
  label       String            @default("Primary Kalshi")
  environment KalshiEnvironment @default(production)
  keyIdHint   String?
  accessKeyIdEncrypted String?
  privateKeyPemEncrypted String?
  credentialsConfiguredAt DateTime?
  syncEnabled Boolean           @default(true)
  lastSyncAt  DateTime?
  syncCursor  Json?
  readOnly    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  appUser     AppUser           @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  fills       Fill[]
  orders      Order[]
  positions   Position[]
  eventPositions EventPosition[]
  settlements Settlement[]
  balances    BalanceSnapshot[]
  syncRuns    SyncRun[]
  sportsFillAnalytics SportsFillAnalytics[]

  @@index([appUserId])
}

model Market {
  ticker         String   @id
  eventTicker    String?
  title          String?
  subtitle       String?
  category       String?
  status         String?
  closeTime      DateTime?
  expirationTime DateTime?
  settlementTime DateTime?
  yesAsk         Int?
  yesBid         Int?
  noAsk          Int?
  noBid          Int?
  lastPrice      Int?
  volume         Decimal? @db.Decimal(20, 4)
  liquidity      Int?
  rawJson        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          Event?   @relation(fields: [eventTicker], references: [ticker])
  fills          Fill[]
  orders         Order[]
  positions      Position[]
  settlements    Settlement[]
  sportsClassification SportsMarketClassification?
  candlesticks   MarketCandlestick[]
  orderbookSnapshots OrderbookSnapshot[]
  sportsFillAnalytics SportsFillAnalytics[]
}

model Event {
  ticker    String   @id
  title     String?
  category  String?
  status    String?
  rawJson   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets   Market[]
  positions EventPosition[]
}

model SportsMarketClassification {
  marketTicker         String   @id
  eventTicker          String?
  eventName            String?
  sport                String?
  league               String?
  marketType           String?
  teams                String[] @default([])
  primaryTeam          String?
  opponentTeam         String?
  classificationSource String   @default("heuristic")
  confidence           Int      @default(0)
  rawJson              Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  market               Market   @relation(fields: [marketTicker], references: [ticker], onDelete: Cascade)

  @@index([sport, league])
  @@index([eventTicker])
}

model MarketCandlestick {
  id                    String   @id @default(cuid())
  marketTicker          String
  periodIntervalMinutes Int      @default(1)
  endPeriod             DateTime
  yesBidCloseCents      Int?
  yesAskCloseCents      Int?
  priceCloseCents       Int?
  priceMeanCents        Int?
  volume                Decimal? @db.Decimal(20, 4)
  openInterest          Decimal? @db.Decimal(20, 4)
  rawJson               Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  market                Market   @relation(fields: [marketTicker], references: [ticker], onDelete: Cascade)

  @@unique([marketTicker, periodIntervalMinutes, endPeriod])
  @@index([marketTicker, endPeriod])
}

model OrderbookSnapshot {
  id              String   @id @default(cuid())
  marketTicker    String
  observedAt      DateTime @default(now())
  yesBidCents     Int?
  yesAskCents     Int?
  noBidCents      Int?
  noAskCents      Int?
  spreadCents     Int?
  midpointCents   Int?
  rawJson         Json
  createdAt       DateTime @default(now())

  market          Market   @relation(fields: [marketTicker], references: [ticker], onDelete: Cascade)

  @@unique([marketTicker, observedAt])
  @@index([marketTicker, observedAt])
}

model Fill {
  id              String        @id @default(cuid())
  kalshiAccountId String
  fillId          String
  tradeId         String?
  orderId         String?
  marketTicker    String
  eventTicker     String?
  outcomeSide     OutcomeSide   @default(unknown)
  action          String?
  contractCount   Decimal       @db.Decimal(20, 4)
  priceCents      Int
  feeCents        Int           @default(0)
  createdTime     DateTime
  source          String        @default("portfolio")
  rawJson         Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  market          Market        @relation(fields: [marketTicker], references: [ticker])

  @@unique([kalshiAccountId, fillId])
  @@index([kalshiAccountId, createdTime])
  @@index([marketTicker])
}

model SportsFillAnalytics {
  id                         String      @id @default(cuid())
  kalshiAccountId            String
  fillId                     String
  marketTicker               String
  eventTicker                String?
  sport                      String?
  league                     String?
  team                       String?
  opponentTeam               String?
  marketType                 String?
  chosenSide                 OutcomeSide @default(unknown)
  entryPriceCents            Int
  priceBucket                String
  clv15mCents                Int?
  clv1hCents                 Int?
  clv6hCents                 Int?
  clv24hCents                Int?
  clvCloseCents              Int?
  nearestOrderbookObservedAt DateTime?
  midPriceCents              Int?
  spreadCents                Int?
  slippageCents              Int?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  account                    KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  market                     Market        @relation(fields: [marketTicker], references: [ticker], onDelete: Cascade)

  @@unique([kalshiAccountId, fillId])
  @@index([kalshiAccountId, marketTicker])
  @@index([sport, league])
}

model Order {
  id              String        @id @default(cuid())
  kalshiAccountId String
  orderId         String
  marketTicker    String
  eventTicker     String?
  outcomeSide     OutcomeSide   @default(unknown)
  action          String?
  status          OrderStatus   @default(unknown)
  originalCount   Decimal?      @db.Decimal(20, 4)
  remainingCount  Decimal?      @db.Decimal(20, 4)
  filledCount     Decimal?      @db.Decimal(20, 4)
  priceCents      Int?
  createdTime     DateTime?
  updatedTime     DateTime?
  source          String        @default("portfolio")
  rawJson         Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  market          Market        @relation(fields: [marketTicker], references: [ticker])

  @@unique([kalshiAccountId, orderId])
  @@index([kalshiAccountId, updatedTime])
  @@index([marketTicker])
}

model Position {
  id                 String        @id @default(cuid())
  kalshiAccountId    String
  marketTicker       String
  eventTicker        String?
  positionContracts  Decimal       @default(0) @db.Decimal(20, 4)
  totalTraded        Decimal       @default(0) @db.Decimal(20, 4)
  averagePriceCents  Int?
  markPriceCents     Int?
  exposureCents      Int?
  realizedPnlCents   Int           @default(0)
  unrealizedPnlCents Int?
  feesPaidCents      Int           @default(0)
  rawJson            Json
  syncedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  account            KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  market             Market        @relation(fields: [marketTicker], references: [ticker])

  @@unique([kalshiAccountId, marketTicker])
  @@index([kalshiAccountId, syncedAt])
}

model EventPosition {
  id                 String        @id @default(cuid())
  kalshiAccountId    String
  eventTicker        String
  totalCostCents     Int?
  totalCostShares    Decimal       @default(0) @db.Decimal(20, 4)
  eventExposureCents Int?
  realizedPnlCents   Int           @default(0)
  feesPaidCents      Int           @default(0)
  rawJson            Json
  syncedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  account            KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  event              Event         @relation(fields: [eventTicker], references: [ticker])

  @@unique([kalshiAccountId, eventTicker])
  @@index([kalshiAccountId, syncedAt])
  @@index([eventTicker])
}

model Settlement {
  id               String        @id @default(cuid())
  kalshiAccountId  String
  marketTicker     String
  eventTicker      String?
  rawHash          String?
  settledTime      DateTime?
  realizedPnlCents Int?
  revenueCents     Int?
  feeCents         Int?
  rawJson          Json
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  account          KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)
  market           Market        @relation(fields: [marketTicker], references: [ticker])

  @@index([kalshiAccountId, settledTime])
  @@index([marketTicker])
  @@unique([kalshiAccountId, rawHash])
}

model BalanceSnapshot {
  id                  String        @id @default(cuid())
  kalshiAccountId     String
  cashBalanceCents    Int?
  portfolioValueCents Int?
  rawJson             Json
  capturedAt          DateTime      @default(now())

  account             KalshiAccount @relation(fields: [kalshiAccountId], references: [id], onDelete: Cascade)

  @@index([kalshiAccountId, capturedAt])
}

model BetNote {
  id           String   @id @default(cuid())
  appUserId    String
  marketTicker String?
  fillId       String?
  title        String?
  thesis       String?
  tags         String[] @default([])
  mistakeType  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appUser      AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, updatedAt])
  @@index([marketTicker])
}

model SyncRun {
  id              String         @id @default(cuid())
  appUserId       String
  kalshiAccountId String?
  status          SyncRunStatus  @default(running)
  kind            String         @default("backfill")
  source          String         @default("api")
  startedAt       DateTime       @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  errorMessage    String?
  cursor          Json?
  stats           Json?

  appUser         AppUser        @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  account         KalshiAccount? @relation(fields: [kalshiAccountId], references: [id], onDelete: SetNull)

  @@index([appUserId, startedAt])
  @@index([kalshiAccountId, startedAt])
}

model Invite {
  id                  String      @id @default(cuid())
  email               String      @unique
  role                AppUserRole @default(user)
  invitedByAppUserId  String?
  acceptedByAppUserId String?     @unique
  acceptedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  invitedBy           AppUser?    @relation("InvitesSent", fields: [invitedByAppUserId], references: [id], onDelete: SetNull)
  acceptedBy          AppUser?    @relation("InviteAcceptedBy", fields: [acceptedByAppUserId], references: [id], onDelete: SetNull)

  @@index([email, revokedAt])
  @@index([invitedByAppUserId])
}
